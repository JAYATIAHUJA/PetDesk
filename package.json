{
  "name": "petdesk",
  "version": "0.1.0",
  "description": "Purposeful Desktop Companions — animated pets that track your deadlines",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [
    "desktop-pet",
    "productivity",
    "electron",
    "shimeji"
  ],
  "author": "PetDesk",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "~28.3.3",
    "electron-builder": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "koffi": "^3.3.0",
    "node-cron": "^3.0.3"
  },
  "build": {
    "appId": "com.petdesk.app",
    "productName": "PetDesk",
    "protocols": [
      {
        "name": "PetDesk",
        "schemes": [
          "petdesk"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PetDesk",
      "artifactName": "petdesk-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "petdesk-portable-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage",
      "category": "Utility"
    },
    "files": [
      "main.mjs",
      "scheduler.mjs",
      "preload.cjs",
      "renderer.mjs",
      "settings.mjs",
      "index.html",
      "settings.html",
      "src/**",
      "characters/**",
      "messages/**",
      "assets/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ]
  },
  "type": "module"
}
